<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Macrobenchmark declares this for a localhost trace server. AlarmControl's offline
         boundary also applies to test APKs, so the permission is removed from the merged APK. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

</manifest>
